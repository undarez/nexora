# LIA web research
# Choose brave, tavily, auto, or none. "auto" tries every configured provider.
LIA_SEARCH_PROVIDER=auto

# Brave Search API
BRAVE_SEARCH_API_KEY=
# Optional override; normally leave unset.
# BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search

# Tavily Search API (optional second provider / fallback)
TAVILY_API_KEY=
# Optional override; normally leave unset.
# TAVILY_SEARCH_API_URL=https://api.tavily.com/search

# NEXORA Brain — NEXORA-owned inference boundary.
# Point this to the self-hosted inference runtime used by the application.
# The runtime must expose an OpenAI-compatible /chat/completions endpoint and /health.
NEXORA_BRAIN_API_URL=
NEXORA_BRAIN_API_KEY=
NEXORA_BRAIN_MODEL=nexora-lia

# Provider policy. native_first means NEXORA Brain first, with legacy local/remote
# paths only when explicitly configured and allowed.
LIA_PROVIDER_MODE=native_first
LIA_ALLOW_REMOTE_FALLBACK=false

# Legacy local runtime (kept for migration/rollback; not required by NEXORA Brain).
OLLAMA_ENABLED=true
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=120000
