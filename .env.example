# LIA web research
# Choose brave, tavily, auto, or none. "auto" tries every configured provider.
LIA_SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
TAVILY_API_KEY=
# TAVILY_SEARCH_API_URL=https://api.tavily.com/search

# NEXORA Brain — NEXORA-owned inference boundary.
# OpenAI-compatible /chat/completions endpoint. Never expose the key to the browser.
NEXORA_BRAIN_API_URL=
NEXORA_BRAIN_API_KEY=
NEXORA_BRAIN_MODEL=nexora-lia
NEXORA_BRAIN_TIMEOUT_MS=120000

# Agentic harness governor
NEXORA_HARNESS_MAX_STEPS=12
NEXORA_HARNESS_MAX_TOOL_CALLS=10
NEXORA_HARNESS_MAX_WALL_MS=180000
NEXORA_HARNESS_MAX_REPEATED_CALLS=1

# Optional persistent memory through self-hosted Letta.
# Keep disabled until a Letta server is running and configured.
LETTA_ENABLED=false
LETTA_BASE_URL=http://127.0.0.1:8283
LETTA_API_KEY=
# Use a model configured in your Letta server (local Ollama is possible).
LETTA_MODEL=

# Nexo voice gateway — Hume first, ElevenLabs fallback/provider option.
# API keys stay server-side only.
NEXORA_VOICE_PROVIDER=hume
HUME_API_KEY=
HUME_VOICE_ID=
HUME_VOICE_NAME=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Provider policy
LIA_PROVIDER_MODE=native_first
LIA_ALLOW_REMOTE_FALLBACK=false

# Legacy local runtime (migration/rollback)
OLLAMA_ENABLED=false
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss-20b-16k
OLLAMA_TIMEOUT_MS=120000
