{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "objective"
  ],
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "context": {
      "type": "object"
    },
    "requested_autonomy_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 8
    },
    "dry_run": {
      "type": "boolean"
    },
    "max_steps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 50
    }
  }
}
