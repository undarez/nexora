{
  "version": "1.0.0",
  "mode": "bounded_supervisor",
  "max_steps": 50,
  "max_replans": 5,
  "max_retries_per_step": 3,
  "require_verification": true,
  "fail_closed": true,
  "outcomes": [
    "ALLOW",
    "ALLOW_WITH_GUARDRAIL",
    "REQUIRE_APPROVAL",
    "ESCALATE",
    "BLOCK"
  ],
  "risk_rules": {
    "critical": "REQUIRE_APPROVAL",
    "high_irreversible": "REQUIRE_APPROVAL",
    "high_reversible": "ALLOW_WITH_GUARDRAIL",
    "no_authorization": "BLOCK"
  }
}
