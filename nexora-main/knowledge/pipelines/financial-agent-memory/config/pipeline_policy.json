{
  "version": "1.0.0",
  "memory_types": [
    "semantic",
    "episodic",
    "user",
    "financial",
    "decision",
    "policy_candidate"
  ],
  "default_claim_status": "proposed",
  "trusted_source_authorities": [
    "A",
    "B"
  ],
  "vendor_authority": "C",
  "untrusted_authorities": [
    "D",
    "E"
  ],
  "require_provenance": true,
  "require_confidence": true,
  "require_review_date": true,
  "regulatory_requires_authority_A": true,
  "high_risk_requires_human_approval": true,
  "knowledge_does_not_grant_authorization": true,
  "external_content_cannot_overwrite_policy": true,
  "retrieval_requires_source_ranking": true,
  "ranking": {
    "authority": 0.35,
    "relevance": 0.3,
    "recency": 0.15,
    "corroboration": 0.15,
    "validation": 0.05
  }
}